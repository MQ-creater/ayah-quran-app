# Copy to .env on the server only. Never commit real credentials.
PORT=3001
QF_ENV=prelive
QF_CLIENT_ID=replace_with_quran_foundation_client_id
QF_CLIENT_SECRET=replace_with_quran_foundation_client_secret
QF_TRANSLATION_ID=131
# Development may leave this list empty. In production, list every approved app origin.
# Example: ALLOWED_ORIGINS=https://ayah.example.com,https://www.ayah.example.com
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
