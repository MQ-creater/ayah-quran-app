{
  "expo": {
    "name": "Ayah",
    "slug": "ayah-quran-app",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Ayah uses the microphone only when you choose to record a recitation practice take.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "android": {
      "package": "com.mqcreater.ayah",
      "versionCode": 1
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mqcreater.ayah",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
